    <!-- Welcome -->
    <string name="welcome_1_title">A scriptorium for what you learn</string>
    <string name="welcome_1_text">After a book, a lecture or a video, write what you understood in your own words. That alone makes much more of it stay.</string>
    <string name="welcome_2_title">Ink fades like memory</string>
    <string name="welcome_2_text">Each page fades along your own forgetting curve. Write it again from memory, and the ink turns black again and holds longer.</string>
    <string name="welcome_ink_1">Spacing beats cramming.</string>
    <string name="welcome_ink_2">Recall is the practice.</string>
    <string name="welcome_ink_3">Own words, own idea.</string>
    <string name="welcome_3_title">The page blooms as you understand</string>
    <string name="welcome_3_text">Answer the novice, find examples from your life, argue with the author: the page earns an initial, vines, gold leaf and a seal.</string>
    <string name="welcome_start">Begin the first codex</string>

