    <!-- The novice -->
    <string name="novice_title">The novice</string>
    <string name="novice_about">about “%s”</string>
    <string name="novice_rule">Explain it simply, without looking at the page. Where the words don\'t come is where understanding is thin.</string>
    <string name="novice_answer_hint">You see, it\'s like this…</string>
    <string name="novice_answer">Explain</string>
    <string name="novice_other">Another question</string>
    <string name="novice_peek">Peek</string>
    <string name="novice_hide">Hide the page</string>
    <string name="novice_thanks">Now I understand! Thank you, brother.</string>
    <string name="novice_more">He has another question</string>
    <string name="novice_done">I\'ve asked everything I wanted. You explain well!</string>
    <string-array name="novice_questions">
        <item>Why is it so?</item>
        <item>Can you give an example from life?</item>
        <item>How would you explain it to a child of ten?</item>
        <item>What would happen if it weren\'t true?</item>
        <item>What does it argue against?</item>
        <item>Where doesn\'t it work?</item>
        <item>What is it like? What else works the same way?</item>
        <item>Why should I care about it?</item>
        <item>What follows from it?</item>
        <item>How does it connect with what you knew before?</item>
        <item>What is the most important word here, and why?</item>
        <item>What do people usually get wrong about it?</item>
        <item>How would you check that it\'s true?</item>
        <item>What would you do differently tomorrow because of it?</item>
        <item>Can you say it in one sentence?</item>
        <item>What is still unclear to you yourself?</item>
    </string-array>

