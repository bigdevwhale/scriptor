    <string name="crafts_title">Crafts</string>
    <string name="crafts_intro">A scriptorium is learned craft by craft. Each opens as you write and restore, and each is a way of remembering that research has shown to work.</string>
    <string name="crafts_open">Crafts open: %1$d of %2$d</string>
    <string name="crafts_all">All crafts</string>
    <string name="craft_opened">A new craft</string>
    <string name="craft_ok">Understood</string>
    <string name="craft_ink">Ink</string>
    <string name="craft_ink_text">Write a page in your own words from memory, and restore it when the ink fades.</string>
    <string name="craft_ink_need">From the start</string>
    <string name="craft_cinnabar">Cinnabar</string>
    <string name="craft_cinnabar_text">Questions on the margin, the golden line and the colophon: the Cornell way. Restorations can now ask by the margin.</string>
    <string name="craft_cinnabar_need">After the first page</string>
    <string name="craft_novice">The novice</string>
    <string name="craft_novice_text">Explain the page simply to a boy who knows nothing. Where you stumble, understanding is thin.</string>
    <string name="craft_novice_need">After two pages</string>
    <string name="craft_lacunae">Lacunae</string>
    <string name="craft_lacunae_text">The mice eat words from your pages, and you fill the gaps from memory.</string>
    <string name="craft_lacunae_need">After the first restoration</string>
    <string name="craft_margins">The margins</string>
    <string name="craft_margins_text">Examples from your life, parables, disputes with the author and the seal of practice.</string>
    <string name="craft_margins_need">After three pages</string>
    <string name="craft_miniature">Miniature</string>
    <string name="craft_miniature_text">Draw the idea with a finger, and draw it again from memory later. Words and pictures together hold better.</string>
    <string name="craft_miniature_need">After five pages</string>
    <string name="craft_disputatio">Disputation</string>
    <string name="craft_disputatio_text">Thesis, the strongest objections, and a reply to each, as the schoolmen did.</string>
    <string name="craft_disputatio_need">After five restorations</string>
    <string name="craft_threads">Red threads</string>
    <string name="craft_threads_text">Tie pages of different books together, and see the map of what leads to what.</string>
    <string name="craft_threads_need">With two codices and four pages</string>
